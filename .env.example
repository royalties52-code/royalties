# ── Supabase (required) ─────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Chat bot (Groq) ───────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key
# GROQ_MODEL=llama-3.1-8b-instant
# CHAT_BOT_ENABLED=true
# CHAT_BOT_SENDER_ID=admin_user_uuid_optional

# ── Email (Resend — optional but recommended for auth emails) ───────────────
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Spinora <noreply@spinoracasinos.com>
# RESEND_REPLY_TO=support@spinoracasinos.com

# ── Telegram admin alerts (optional) ──────────────────────────────────────
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ADMIN_CHAT_ID=
# TELEGRAM_PROMO_CHAT_ID=

# ── Cron jobs (optional — newsletters / telegram promo) ─────────────────────
# CRON_SECRET=random_long_string

# ── Deposit display usernames (optional — shown on deposit page) ────────────
# NEXT_PUBLIC_DEPOSIT_CASHAPP=$YourCashTag
# NEXT_PUBLIC_DEPOSIT_ZELLE=your@email.com
# NEXT_PUBLIC_DEPOSIT_BITCOIN=bc1...
# NEXT_PUBLIC_DEPOSIT_USDT=0x...

# ── Social links (optional) ─────────────────────────────────────────────────
# NEXT_PUBLIC_TELEGRAM_URL=
# NEXT_PUBLIC_FACEBOOK_URL=
# NEXT_PUBLIC_INSTAGRAM_URL=
# NEXT_PUBLIC_TIKTOK_URL=

# ── Game automation — external agent APIs (server-only, never NEXT_PUBLIC) ──
# When credentials below are set, create / load / redeem / balance run instantly via API.
# If a game’s credentials are missing, requests stay pending for bot workers (workers/*-bot/).
#
# Whitelisted IP: many providers require API calls from a fixed IP. Set each game’s
# *_PROXY_URL to your free proxy (http://user:pass@host:port). Juwa/Vegas/Game Vault
# share GAMEVAULT_PROXY_URL as fallback when their own proxy is unset.
#
# ── Juwa (MD5 signed REST — external.juwa777.com) ───────────────────────────
# JUWA_AGENT_ID=
# JUWA_SECRET_KEY=
# JUWA_PROXY_URL=
# JUWA_API_URL=https://external.juwa777.com
# JUWA_ADMIN_URL=https://ht.juwa777.com/login
#
# ── Vegas Sweeps (MD5 signed REST — apius.lasvegassweeps.com) ───────────────
# VEGAS_AGENT_ID=
# VEGAS_SECRET_KEY=
# VEGAS_PROXY_URL=
# VEGAS_API_URL=https://apius.lasvegassweeps.com
# VEGAS_ADMIN_URL=https://agent.lasvegassweeps.com/login
#
# ── Game Vault (MD5 signed REST — apius.gamevault999.com) ───────────────────
# GAMEVAULT_AGENT_ID=
# GAMEVAULT_SECRET_KEY=
# GAMEVAULT_PROXY_URL=
# GAMEVAULT_API_BASE_URL=https://apius.gamevault999.com
# GAMEVAULT_ADMIN_URL=https://agent.gamevault999.com/login
#
# ── Gameroom (agent login token REST) ───────────────────────────────────────
# GAMEROOM_AGENT_USERNAME=your_store_login
# GAMEROOM_AGENT_PASSWORD="your_password"
# GAMEROOM_STORE_NAME=your_store_login
# GAMEROOM_ADMIN_URL=https://agentserver1.gameroom777.com/admin/login
# GAMEROOM_API_BASE_URL=https://agentserver1.gameroom777.com
# GAMEROOM_PROXY_URL=http://user:pass@proxy-host:port
#
# ── Cash Machine (agent login token REST) ─────────────────────────────────────
# CASHMACHINE_AGENT_USERNAME=your_store_login
# CASHMACHINE_AGENT_PASSWORD="your_password"
# CASHMACHINE_STORE_NAME=your_store_login
# CASHMACHINE_ADMIN_URL=https://agentserver.cashmachine777.com/admin/login
# CASHMACHINE_API_BASE_URL=https://agentserver.cashmachine777.com
# CASHMACHINE_PROXY_URL=http://user:pass@proxy-host:port
#
# ── Cash Frenzy (agent login token REST) ──────────────────────────────────────
# CASHFRENZY_AGENT_USERNAME=
# CASHFRENZY_AGENT_PASSWORD=
# CASHFRENZY_ADMIN_URL=https://agentserver.cashfrenzy777.com/admin/login
#
# ── Mafia (agent login token REST) ────────────────────────────────────────────
# MAFIA_AGENT_USERNAME=your_store_login
# MAFIA_AGENT_PASSWORD="your_password"
# MAFIA_STORE_NAME=your_store_login
# MAFIA_ADMIN_URL=https://agentserver.mafia77777.com/admin/login
#
# ── Mr All In One (agent login token REST + optional proxy) ───────────────────
# MRALLINONE_AGENT_USERNAME=your_store_login
# MRALLINONE_AGENT_PASSWORD="your_password"
# MRALLINONE_STORE_NAME=your_store_login
# GAMEVAULT_PROXY_URL=http://user:pass@proxy-host:port
# MRALLINONE_PROXY_URL=http://user:pass@proxy-host:port
# MRALLINONE_ADMIN_URL=https://agentserver.mrallinone777.com/admin/login
# MRALLINONE_API_BASE_URL=https://agentserver.mrallinone777.com
#
# Bot worker remote control (optional — separate PC running workers/*-bot/)
# GAME_AUTOMATION_SECRET=
